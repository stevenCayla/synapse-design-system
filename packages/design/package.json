{
  "name": "@synapse-medical/design",
  "version": "0.0.0",
  "private": true,
  "description": "Synapse Design System: styles, tokens, assets and Twig partials.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./styles.css": "./src/index.css",
    "./tokens.css": "./generated/tokens.css",
    "./tokens": {
      "types": "./generated/tokens.d.ts",
      "default": "./generated/tokens.js"
    },
    "./tokens.json": "./generated/tokens.json",
    "./fixtures": {
      "types": "./scripts/fixtures.d.ts",
      "default": "./scripts/fixtures.mjs"
    },
    "./fonts.css": "./src/foundations/fonts.css",
    "./contrast": {
      "types": "./scripts/contrast.d.ts",
      "default": "./scripts/contrast.mjs"
    },
    "./contrast-pairs.json": "./tokens/contrast-pairs.json"
  },
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "twing": "7.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "lightningcss": "^1.33.0",
    "style-dictionary": "^5.7.1"
  }
}

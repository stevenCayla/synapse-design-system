// Cloudflare Workers hosting: static assets only.
//   wrangler deploy --env=""   → production: design.synapse-medical.fr     (a release tag)
//   wrangler deploy --env dev  → staging:    dev-design.synapse-medical.fr (main branch)
// Security and cache headers: public/_headers (copied into dist/ at build time).
{
  "$schema": "../../node_modules/.pnpm/wrangler@4.155.0/node_modules/wrangler/config-schema.json",
  "name": "synapse-design",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "design.synapse-medical.fr", "custom_domain": true }],
  "env": {
    "dev": {
      "routes": [{ "pattern": "dev-design.synapse-medical.fr", "custom_domain": true }]
    }
  }
}

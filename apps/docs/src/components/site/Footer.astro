---
import Default from '@astrojs/starlight/components/Footer.astro';
import { langOf, t } from '../../lib/i18n';

const splash = Astro.locals.starlightRoute.entry.data.template === 'splash';
const lang = langOf(Astro.currentLocale);
const text = t(Astro.currentLocale);
const year = new Date().getFullYear();
---

{!splash && <Default />}
<footer class="ds-foot" data-pagefind-ignore>
  <span>© {year} Synapse Medical</span>
  <nav aria-label={text.links}>
    <a href={lang === 'en' ? 'https://synapse-medical.fr/en/' : 'https://synapse-medical.fr/'}>{text.website}</a>
    <a href={lang === 'en' ? 'https://docs.synapse-medical.fr/en/' : 'https://docs.synapse-medical.fr/'}>Documentation</a>
    <a href="https://github.com/stevenCayla/synapse-design-system">GitHub</a>
  </nav>
</footer>

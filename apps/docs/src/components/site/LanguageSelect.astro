---
// FR / EN links instead of a select, as on the other public sites.
import { langOf, t } from '../../lib/i18n';

const { id } = Astro.locals.starlightRoute;
const current = langOf(Astro.currentLocale);
const notFound = /(^|\/)404$/.test(id);
const rest = notFound ? '/' : Astro.url.pathname.replace(/^\/fr(\/|$)/, '/');
const paths = { en: rest, fr: `/fr${rest}` };
---

<div class="ds-lang" role="group" aria-label={t(Astro.currentLocale).language}>
  <a href={paths.fr} hreflang="fr" lang="fr" aria-current={current === 'fr' ? 'true' : undefined}>FR</a>
  <a href={paths.en} hreflang="en" lang="en" aria-current={current === 'en' ? 'true' : undefined}>EN</a>
</div>

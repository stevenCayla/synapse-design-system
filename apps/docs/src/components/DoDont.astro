---
import { t } from '../lib/i18n';

const labels = t(Astro.currentLocale);
---

<div class="si-doc-dodont">
  <div class="si-doc-dodont__do">
    <p class="si-doc-dodont__label">{labels.do}</p>
    <slot name="do" />
  </div>
  <div class="si-doc-dodont__dont">
    <p class="si-doc-dodont__label">{labels.dont}</p>
    <slot name="dont" />
  </div>
</div>

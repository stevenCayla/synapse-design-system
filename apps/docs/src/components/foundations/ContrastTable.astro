---
// Measured from the tokens, the same computation as the check that runs in CI.
import { contrastReport } from '@synapse-medical/design/contrast';
import pairs from '@synapse-medical/design/contrast-pairs.json';
import { tokens } from '@synapse-medical/design/tokens';
import { t } from '../../lib/i18n';

const labels = t(Astro.currentLocale);
const rows = contrastReport(tokens, pairs.pairs);
const keys = [...new Set(rows.map((row) => `${row.fg}|${row.on}`))];
const ratio = (key: string, theme: string) => {
  const row = rows.find((item) => `${item.fg}|${item.on}` === key && item.theme === theme);
  return row?.ratio?.toFixed(2) ?? '';
};
const minimum = (key: string) => rows.find((item) => `${item.fg}|${item.on}` === key)?.min;
---

<table class="si-doc-table">
  <thead>
    <tr><th>{labels.foreground}</th><th>{labels.background}</th><th>{labels.minimum}</th><th>{labels.light}</th><th>{labels.dark}</th></tr>
  </thead>
  <tbody>
    {
      keys.map((key) => {
        const [fg, on] = key.split('|');
        return (
          <tr>
            <td><code>{fg}</code></td>
            <td><code>{on}</code></td>
            <td>{minimum(key)}:1</td>
            <td>{ratio(key, 'light')}:1</td>
            <td>{ratio(key, 'dark')}:1</td>
          </tr>
        );
      })
    }
  </tbody>
</table>

---
// Every fixture of a component.
import { listFixtures } from '@synapse-medical/design/fixtures';
import Preview from './Preview.astro';

interface Props {
  component: string;
}

const { component } = Astro.props;
const fixtures = listFixtures().filter((fixture) => fixture.component === component);
---

{
  fixtures.map((fixture) => (
    <>
      <h3>{fixture.title}</h3>
      <Preview fixture={fixture} />
    </>
  ))
}
